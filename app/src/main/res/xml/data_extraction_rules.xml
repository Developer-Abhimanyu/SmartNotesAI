<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <!-- Cloud backup: notes and chat history. -->
    <cloud-backup>
        <include
            domain="database"
            path="." />
    </cloud-backup>

    <!-- Device-to-device transfer: notes and chat history. -->
    <device-transfer>
        <include
            domain="database"
            path="." />
    </device-transfer>

</data-extraction-rules>
